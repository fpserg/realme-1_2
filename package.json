    "@types/node": "24.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "dotenv": "17.2.1",
    "drizzle-kit": "0.31.10",
