# Public application identity. This value is safe to expose to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only PostgreSQL connection used by Drizzle and application adapters.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public Supabase client configuration. Use a publishable key, not a service key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Context lock. The expected ref must match the hostname above. Preview and
# staging contexts must use synthetic data classification.
REALME_ENVIRONMENT=local
REALME_DATA_CLASSIFICATION=synthetic
REALME_EXPECTED_SUPABASE_PROJECT_REF=local

# Server-only migration/administration boundary. Application runtime code must
# not use this key. Never expose it through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Protects internal job-dispatch endpoints. Generate independently per environment.
JOB_DISPATCH_SECRET=replace-with-a-random-server-only-secret
