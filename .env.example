# Public application identity. This value is safe to expose to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only PostgreSQL connection used by Drizzle and application adapters.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public Supabase client configuration. Use a publishable key, not a service key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Context lock. The expected ref must match the hostname above. Preview and
# staging contexts must use synthetic data classification.
REALME_ENVIRONMENT=local
REALME_DATA_CLASSIFICATION=synthetic
REALME_EXPECTED_SUPABASE_PROJECT_REF=local

# Server-only migration/administration boundary. Application runtime code must
# not use this key. Never expose it through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Protects internal job-dispatch endpoints. Generate independently per environment.
JOB_DISPATCH_SECRET=replace-with-a-random-server-only-secret

# Server-only Step 101 dialogue provider. The normal runtime recognizes only
# the explicit live provider; E2E fixtures use a separate route and cannot be
# selected here. Never prefix the API key with NEXT_PUBLIC_.
REALME_DIALOGUE_PROVIDER=openai
REALME_DIALOGUE_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=replace-with-server-only-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Server-only Step 102 interpretation worker. The direct PostgreSQL connection
# is used only by the protected worker boundary; never expose it to the browser.
REALME_INTERPRETATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REALME_INTERPRETATION_PROVIDER=openai
REALME_INTERPRETATION_MODEL=gpt-5.4-mini-2026-03-17
